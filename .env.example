# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site (used in emails, certificates and QR codes)
NEXT_PUBLIC_SITE_URL=https://care.sylvanply.com

# Outgoing email over SMTP (Amazon SES SMTP in production). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SylvanCare+ <care@sylvanply.com>"
